# Salin ke deploy/wms.env (JANGAN di-commit — sudah di .gitignore) lalu isi.
# Buat nilai acak:  openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

# ── Database (container postgres di compose yang sama) ──────────────────────
POSTGRES_USER=wms
POSTGRES_DB=wms
POSTGRES_PASSWORD=GANTI_password_db_acak

# ── Rahasia aplikasi (≥ 32 karakter, beda satu sama lain) ───────────────────
JWT_SECRET=GANTI_minimal_32_karakter_acak_xxxxxxxxxxxxxxxx
SESSION_SECRET=GANTI_minimal_32_karakter_acak_yyyyyyyyyyyyyyyy

# ── Web ─────────────────────────────────────────────────────────────────────
# 127.0.0.1 = hanya bisa diakses dari server ini (di balik reverse proxy ber-TLS).
# 0.0.0.0   = terbuka ke jaringan (hanya untuk uji LAN; cookie aman butuh HTTPS).
WMS_BIND=127.0.0.1
WMS_PORT=3000
BRAND_ID=default
LOG_LEVEL=info

# Cookie sesi hanya lewat HTTPS (default true). Set false HANYA untuk uji tanpa TLS
# (mis. http://192.168.x.x:3000 di LAN) — browser menolak cookie Secure di HTTP biasa.
COOKIE_SECURE=true
