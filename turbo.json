{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["BRAND_ID", "NODE_ENV"]
    },
    "lint": {},
    "type-check": { "dependsOn": ["^type-check"] },
    "test": { "outputs": ["coverage/**"] },
    "test:integration": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
