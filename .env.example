# Salin ke .env (root) — dibaca apps/web dan packages/db
DATABASE_URL=postgres://wms:wms@localhost:5433/wms
# Rahasia (auth-session §1) — WAJIB diganti di produksi, min 32 karakter, beda satu sama lain
JWT_SECRET=dev-only-change-me-32-characters-minimum!!
SESSION_SECRET=dev-only-session-seal-32-characters-min!!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_REUSE_GRACE_SECONDS=30
DB_LOCK_TIMEOUT_MS=4000
DB_STATEMENT_TIMEOUT_MS=15000
# Brand FE yang dibangun (apps/web/brands/<BRAND_ID>)
BRAND_ID=default
# Rentang versi schema yang didukung app (dibaca /api/ready)
SCHEMA_MIN_VERSION=0001
SCHEMA_MAX_VERSION=0001
LOG_LEVEL=info
